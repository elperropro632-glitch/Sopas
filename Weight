local Players = game:GetService("Players")
local player = Players.LocalPlayer
local RunService = game:GetService("RunService")

local TOOL_NAME = "Weight"

local function getTool()
    return player.Backpack:FindFirstChild(TOOL_NAME) or player.Character:FindFirstChild(TOOL_NAME)
end

local function equip()
    local tool = player.Backpack:FindFirstChild(TOOL_NAME)
    if tool then
        tool.Parent = player.Character
    end
end

-- Conexión ultra rápida
RunService.RenderStepped:Connect(function()
    local tool = getTool()
    
    if tool then
        if tool.Parent == player.Backpack then
            equip()
        end
        if tool.Parent == player.Character then
            -- spam de activación lo más rápido posible
            for i = 1, 10 do
                tool:Activate()
            end
        end
    end
end)
